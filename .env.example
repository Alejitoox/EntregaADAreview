DATABASE_URL=postgres://complex_schedule:local_dev_password@localhost:5432/complex_schedule

# Si ya tienes otro PostgreSQL usando el puerto 5432, usa otro puerto para Docker
# (por ejemplo DB_PORT=5434 en un archivo .env) y cambia el puerto en DATABASE_URL.
# DB_PORT=5432

# --- Modo Supabase (login real + base de datos en la nube) ---
# Si defines estas dos variables la app usa Supabase Auth. Ver docs/supabase.md.
# NEXT_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clave publishable>
# En ese modo, DATABASE_URL es la cadena del "Session pooler" de Supabase.
