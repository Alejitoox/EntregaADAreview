# Supabase (login real + base de datos). Ver docs/supabase.md.
# Las dos primeras son públicas (van al navegador): URL del proyecto y clave publishable.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clave publishable>

# Cadena del "Session pooler" de Supabase (solo la usa el servidor).
DATABASE_URL=postgresql://postgres.<ref-del-proyecto>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres
